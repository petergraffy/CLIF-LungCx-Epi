# R specific gitignores
.Rprofile
.Rhistory
.Ruserdata
.DS_Store
*.Rproj
.Rproj.user

# Project libraries are restored from the tracked renv.lock
/renv/
/code/renv/
/code/renv.lock
initialize_renv.R

## ignore filtered CLIF tables stored as Rdata
*.RData

#ignore source CLIF_ files 
CLIF_*.parquet
CLIF_*.csv
CLIF_*.fst

#ignore the identifier app
CLIF_cohort_identifier*

# Output and logs (may contain PHI-adjacent data)
/output/run_*/

# ignore pdf reports and rendered html
*.pdf
*.html

# Private site settings and Python runtime caches
/config/config.json
__pycache__/
*.py[cod]
/config/site_metadata.csv

/.venv/
/config/site.json
/config/coordinator.json
/incoming/
/bundles/
