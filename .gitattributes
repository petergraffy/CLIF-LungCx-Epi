# Source contracts also normalize CRLF, covering existing Windows checkouts.
*.R text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.lock text eol=lf
*.txt text eol=lf
*.bat text eol=crlf

# Frozen bundle checksums must survive Windows Git checkout without CRLF conversion.
/frozen/** text eol=lf
